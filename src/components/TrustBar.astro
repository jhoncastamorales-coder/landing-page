---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="border-y border-outline-variant/40 bg-surface-low">
  <div
    class="mx-auto flex max-w-page flex-col items-center gap-6 px-5 py-10 md:flex-row md:gap-10 md:px-10 xl:px-20"
  >
    <p class="shrink-0 text-label-caps text-on-surface-muted uppercase">{t.trust.label}</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:justify-start">
      {
        t.trust.items.map((item) => (
          <li class="text-body-md font-semibold text-on-surface-variant/80">{item}</li>
        ))
      }
    </ul>
  </div>
</div>
