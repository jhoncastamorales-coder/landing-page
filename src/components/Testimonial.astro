---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const initials = t.testimonial.author
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<Section>
  <figure class="glass mx-auto max-w-3xl rounded-2xl p-8 text-center md:p-12">
    <Icon name="quote" size={36} class="mx-auto text-primary/60" />
    <blockquote class="mt-6 text-headline-md leading-relaxed font-medium text-brand text-pretty">
      {t.testimonial.quote}
    </blockquote>
    <figcaption class="mt-8 flex items-center justify-center gap-3">
      <span
        class="flex size-11 items-center justify-center rounded-full bg-primary text-label-caps text-on-primary"
      >
        {initials}
      </span>
      <span class="text-left">
        <span class="block text-body-md font-bold text-on-surface">{t.testimonial.author}</span>
        <span class="block text-body-md text-on-surface-muted">{t.testimonial.role}</span>
      </span>
    </figcaption>
  </figure>
</Section>
