---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const days = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];

const inventory: { label: string; kind: 'room' | 'bed'; blocks: [number, number, boolean][] }[] = [
  { label: '101', kind: 'room', blocks: [[0, 3, true], [4, 2, false]] },
  { label: '102', kind: 'room', blocks: [[1, 4, false]] },
  { label: '201', kind: 'room', blocks: [[0, 2, false], [3, 4, true]] },
  { label: 'A1', kind: 'bed', blocks: [[0, 2, true], [2, 3, false]] },
  { label: 'A2', kind: 'bed', blocks: [[1, 3, false], [5, 2, true]] },
  { label: 'A3', kind: 'bed', blocks: [[0, 5, true]] },
];
---

<Section id="solutions">
  <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-gutter">
    <div>
      <p class="text-label-caps text-primary uppercase">{t.hybrid.eyebrow}</p>
      <h2 class="headline-section mt-3 text-brand text-balance">{t.hybrid.title}</h2>
      <p class="mt-5 text-body-lg text-on-surface-variant text-pretty">{t.hybrid.body}</p>

      <ul class="mt-8 space-y-4">
        {
          t.hybrid.points.map((point) => (
            <li class="flex items-start gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-primary" />
              <span class="text-body-md text-on-surface-variant">{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="glass rounded-2xl p-5 shadow-[var(--shadow-ambient)] sm:p-7">
      <div class="flex items-center justify-between gap-4">
        <p class="text-label-caps text-on-surface-muted uppercase">{t.hybrid.chartLabel}</p>
        <div class="flex items-center gap-4 text-label-caps text-on-surface-muted uppercase">
          <span class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-sm bg-primary"></span>{t.hybrid.roomLabel}
          </span>
          <span class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-sm bg-accent"></span>{t.hybrid.bedLabel}
          </span>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-[2.5rem_1fr] gap-x-3">
        <span></span>
        <div class="grid grid-cols-7 gap-1 text-center text-label-caps text-on-surface-muted">
          {days.map((day) => <span>{day}</span>)}
        </div>

        {
          inventory.map((row) => (
            <>
              <span class="flex items-center gap-1 py-1 text-label-caps text-on-surface-muted">
                {row.kind === 'bed' && <span class="text-accent">·</span>}
                {row.label}
              </span>
              <div class="relative my-1 grid grid-cols-7 gap-1">
                {days.map(() => <span class="h-6 rounded bg-surface-container" />)}
                {row.blocks.map(([start, span, filled]) => (
                  <span
                    class:list={[
                      'absolute inset-y-0 rounded',
                      row.kind === 'bed' ? 'bg-accent' : 'bg-primary',
                      filled ? '' : 'opacity-45',
                    ]}
                    style={`left:calc(${start} * (100% / 7));width:calc(${span} * (100% / 7) - 0.25rem)`}
                  />
                ))}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</Section>
