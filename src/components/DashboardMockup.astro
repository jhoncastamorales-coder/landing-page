---
/**
 * Stylised ATRIO/PMS dashboard used as the hero visual.
 * Drawn with markup rather than a screenshot so it stays crisp at any size and
 * repaints itself for light/dark from the same design tokens as the page.
 */
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

const kpis = [
  { label: 'ADR', value: '142 €' },
  { label: 'RevPAR', value: '118 €' },
  { label: t.hybrid.roomLabel, value: '86%' },
];

// Occupancy curve — plotted in a 0 0 300 90 viewBox.
const curve = 'M0,68 C24,62 40,44 62,42 C86,40 100,58 124,54 C150,50 160,26 186,24 C214,22 226,40 250,34 C272,29 286,16 300,12';

// Front-desk counters for "today". The tape chart lives in its own section,
// so the hero panel stays a summary rather than repeating it.
const today = [
  { label: t.hero.arrivals, value: '18', tone: 'bg-primary' },
  { label: t.hero.departures, value: '11', tone: 'bg-accent' },
  { label: t.hero.inHouse, value: '64', tone: 'bg-success' },
];
---

<div
  class:list={[
    'overflow-hidden rounded-2xl border border-outline-variant/50 bg-surface-lowest shadow-[var(--shadow-raised)]',
    className,
  ]}
  role="img"
  aria-label={t.meta.description}
>
  <!-- Window chrome -->
  <div
    class="flex items-center gap-2 border-b border-outline-variant/40 bg-surface-low px-4 py-3"
  >
    <span class="size-2.5 rounded-full bg-outline-variant"></span>
    <span class="size-2.5 rounded-full bg-outline-variant"></span>
    <span class="size-2.5 rounded-full bg-outline-variant"></span>
    <span class="ml-3 text-label-caps text-on-surface-muted uppercase">atrio/pms · dashboard</span>
  </div>

  <div class="grid grid-cols-[3rem_1fr] sm:grid-cols-[4.5rem_1fr]">
    <!-- Rail -->
    <div class="flex flex-col items-center gap-3 border-r border-outline-variant/40 bg-surface-low py-5">
      <span class="size-8 rounded-lg bg-primary"></span>
      <span class="size-8 rounded-lg bg-surface-highest"></span>
      <span class="size-8 rounded-lg bg-surface-highest"></span>
      <span class="size-8 rounded-lg bg-surface-highest"></span>
    </div>

    {/* Extra bottom padding leaves room for the stat badge that overlaps this edge. */}
    <div class="space-y-4 p-4 pb-10 sm:p-5 sm:pb-12">
      <!-- KPI row -->
      <div class="grid grid-cols-3 gap-2 sm:gap-3">
        {
          kpis.map((kpi) => (
            <div class="rounded-xl border border-outline-variant/40 bg-surface p-2.5 sm:p-3">
              <p class="text-label-caps text-on-surface-muted uppercase">{kpi.label}</p>
              <p class="mt-1 text-body-lg font-bold text-on-surface">{kpi.value}</p>
            </div>
          ))
        }
      </div>

      <!-- Occupancy chart -->
      <div class="rounded-xl border border-outline-variant/40 bg-surface p-3">
        <div class="flex items-center justify-between">
          <p class="text-label-caps text-on-surface-muted uppercase">{t.hero.statLabel}</p>
          <p class="text-label-caps text-success uppercase">{t.hero.statValue}</p>
        </div>
        <svg viewBox="0 0 300 90" class="mt-2 h-20 w-full" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="occ-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--primary)" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="var(--primary)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={`${curve} L300,90 L0,90 Z`} fill="url(#occ-fill)"></path>
          <path
            d={curve}
            fill="none"
            stroke="var(--primary)"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <circle cx="300" cy="12" r="4" fill="var(--primary)"></circle>
        </svg>
      </div>

      <!-- Front-desk counters -->
      <div class="rounded-xl border border-outline-variant/40 bg-surface p-3">
        <p class="text-label-caps text-on-surface-muted uppercase">{t.hero.today}</p>
        <div class="mt-3 space-y-2">
          {
            today.map((row) => (
              <div class="flex items-center gap-3">
                <span class:list={['size-2.5 shrink-0 rounded-full', row.tone]} />
                <span class="grow text-body-md text-on-surface-variant">{row.label}</span>
                <span class="text-body-md font-bold text-on-surface">{row.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
