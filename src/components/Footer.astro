---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rights = t.footer.rights.replace('{year}', String(new Date().getFullYear()));
---

<footer class="border-t border-outline-variant/40 bg-surface-low">
  <div class="mx-auto max-w-page px-5 py-16 md:px-10 xl:px-20">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="text-logo">
          <Logo class="h-9 w-auto" />
        </div>
        <p class="mt-4 max-w-xs text-body-md text-on-surface-variant">{t.footer.tagline}</p>
        <LanguageSwitcher lang={lang} class="mt-6 w-fit" />
      </div>

      {
        t.footer.columns.map((column) => (
          <nav aria-label={column.title}>
            {/* h3, not h2: footer labels must not compete with the page's content headings. */}
            <h3 class="text-label-caps text-on-surface uppercase">{column.title}</h3>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href="#"
                    class="text-body-md text-on-surface-variant transition-colors hover:text-primary"
                  >
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-14 border-t border-outline-variant/40 pt-8 text-body-md text-on-surface-muted">
      {rights}
    </p>
  </div>
</footer>
