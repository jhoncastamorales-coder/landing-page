---
import Section from './Section.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section>
  <div class="mx-auto mb-12 max-w-2xl text-center">
    <h2 class="headline-section text-brand text-balance">{t.stats.title}</h2>
    <p class="mt-4 text-body-lg text-on-surface-variant text-pretty">{t.stats.subtitle}</p>
  </div>

  <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-outline-variant/40 lg:grid-cols-4">
    {
      t.stats.items.map((item) => (
        <div class="flex flex-col-reverse items-center gap-2 bg-surface px-6 py-10 text-center">
          <dt class="text-label-caps text-on-surface-muted uppercase">{item.label}</dt>
          <dd class="text-[2.5rem] leading-none font-extrabold tracking-tight text-primary">
            {item.value}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
