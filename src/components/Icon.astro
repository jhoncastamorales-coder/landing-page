---
import type { HTMLAttributes } from 'astro/types';
import { iconPaths, type IconName } from '../lib/icons';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: IconName;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 24, class: className, strokeWidth = 1.75, ...rest } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={iconPaths[name]}
/>
